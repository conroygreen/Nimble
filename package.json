{
  "name": "nimble",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @nimble/web dev",
    "dev:api": "pnpm --filter @nimble/api start:dev",
    "dev:worker": "pnpm --filter @nimble/worker dev",
    "dev": "concurrently -n web,api,worker -c green,blue,magenta \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\"",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint || true",
    "test": "pnpm -r test || true",
    "format": "pnpm -r format || true",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.6.3",
    "@types/node": "^20.11.30",
    "prisma": "^5.20.0"
  }
}
