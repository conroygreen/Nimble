{
  "name": "nimble-printing-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Hybrid B2B + B2C Printing SaaS Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "cd prisma && npx prisma migrate dev",
    "db:generate": "cd prisma && npx prisma generate",
    "db:seed": "cd prisma && npx tsx seed.ts",
    "web:dev": "npm run dev --workspace=apps/web",
    "api:dev": "npm run dev --workspace=apps/api",
    "worker:dev": "npm run dev --workspace=apps/worker"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
