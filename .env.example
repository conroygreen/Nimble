# Database
# PostgreSQL connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nimble"

# Redis
# Redis connection URL for BullMQ workers
REDIS_URL="redis://localhost:6379"

# API Server
# Port for the NestJS API server
PORT=4000

# CORS
# Web application URL for CORS configuration
WEB_URL="http://localhost:3000"

# AWS S3 (Optional - required for file uploads)
# S3 region for file storage
S3_REGION="us-east-1"
# S3 bucket name for storing files
S3_BUCKET=""
# AWS access key ID for S3
S3_ACCESS_KEY_ID=""
# AWS secret access key for S3
S3_SECRET_ACCESS_KEY=""

# Stripe (Optional - required for payment processing)
# Stripe secret key for payment processing
STRIPE_SECRET_KEY=""
